NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional locally, recommended in production. The origin confirmation emails link back to.
# When it is unset the app derives the origin from the request it is serving (the x-forwarded-proto
# and x-forwarded-host headers Vercel sets), which is correct for a normal deployment. Set this
# when something in front of the app rewrites or drops those headers, or to pin a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example.com
